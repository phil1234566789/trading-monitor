[Unit]
Description=Trading Monitor Setup 2 live algorithm watcher
After=docker.service network-online.target
Requires=docker.service
[Service]
Restart=always
RestartSec=10
ExecStart=/usr/bin/docker run --rm --name setup2-watcher --user 1000:1000 --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges --memory 768m --cpus 1 --env-file /opt/setup2-watcher/watcher.env -v /opt/setup2-watcher/runner.mjs:/app/runner.mjs:ro node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 node /app/runner.mjs
ExecStop=/usr/bin/docker stop -t 30 setup2-watcher
TimeoutStopSec=45
[Install]
WantedBy=multi-user.target
